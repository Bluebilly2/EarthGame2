Unity/*.mdb.meta
Unity/sysinfo.txt
Unity/crashlytics-build.properties
Unity/Assets/StreamingAssets/aa.meta
Unity/Assets/StreamingAssets/aa/*

# dotnet (engine-free packages and tests): all intermediate output is redirected to Engine/.build/
Engine/.build/
**/bin/
**/obj/
*.user
.vs/
.idea/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Datasets: fetched, never committed (see Docs/DATA_SOURCES.md). Small test fixtures are the exception.
Data/*
!Data/fixtures/
!Data/README.md
# The two Bureau station tables the weather stands on, copied by hand from the owner's browser (M1.8c).
!Data/stations/

# Worlds, builds, run artefacts
Saves/
/Build/
Runs/
*.log

# Generated knowledge graphs and other build artefacts are maps, never canon (STANDARDS 17)
graphify-out/
Artefacts/

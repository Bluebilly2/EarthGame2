<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The engine's sun, written out for someone who does not trust the engine: prints one eg2.almanac line per day
    (ARCHITECTURE.md §10) for the owner's solar_check.py to compare against a formula of its own. Run the built
    assembly with +key value arguments, for example "+day 237", "+region bherwerre +day 237 +to 244", or
    "+lat -35.14 +lon 150.675 +day 1 +hour 8" (Tools/verifiers/README.md shows the full command line).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EarthGame.Almanac</RootNamespace>
    <AssemblyName>EarthGame.Almanac</AssemblyName>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../EarthGame.Engine.csproj" />
  </ItemGroup>
</Project>
